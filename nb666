-- ===== 独立 GUI 骨骼绘制模块（优化版 + 队伍检查联动 + NPC 支持） =====
do
    local BoneGui = Instance.new("ScreenGui")
    BoneGui.Name = "BoneGui"
    BoneGui.ResetOnSpawn = false
    BoneGui.IgnoreGuiInset = true
    BoneGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    BoneGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    getgenv().BoneESPEnabled = false
    getgenv().BoneESPColor = Color3.fromRGB(0, 255, 0)
    getgenv().BoneESPThickness = 2

    local BONE_PAIRS_R15 = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LowerTorso", "RightUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
    }

    local BONE_PAIRS_R6 = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"},
        {"Left Arm", "LeftHand"},
        {"Right Arm", "RightHand"},
        {"Left Leg", "LeftFoot"},
        {"Right Leg", "RightFoot"},
    }

    local function getBonePairs(character)
        if character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso") then
            return BONE_PAIRS_R15
        elseif character:FindFirstChild("Torso") then
            return BONE_PAIRS_R6
        end
        return BONE_PAIRS_R15
    end

    local function getPart(character, name)
        local found = character:FindFirstChild(name)
        if found and found:IsA("BasePart") then return found end

        local aliases = {
            ["UpperTorso"] = {"Torso"},
            ["LowerTorso"] = {"Torso"},
            ["LeftUpperArm"] = {"Left Arm"},
            ["RightUpperArm"] = {"Right Arm"},
            ["LeftLowerArm"] = {"LeftArm"},
            ["RightLowerArm"] = {"RightArm"},
            ["LeftHand"] = {"Left Arm"},
            ["RightHand"] = {"Right Arm"},
            ["LeftUpperLeg"] = {"Left Leg"},
            ["RightUpperLeg"] = {"Right Leg"},
            ["LeftLowerLeg"] = {"LeftLeg"},
            ["RightLowerLeg"] = {"RightLeg"},
            ["LeftFoot"] = {"Left Leg"},
            ["RightFoot"] = {"Right Leg"},
        }
        if aliases[name] then
            for _, alias in ipairs(aliases[name]) do
                local part = character:FindFirstChild(alias)
                if part and part:IsA("BasePart") then return part end
            end
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local success, bodyPart = pcall(function()
                local mapping = {
                    Head = Enum.BodyPartR15.Head,
                    UpperTorso = Enum.BodyPartR15.UpperTorso,
                    LowerTorso = Enum.BodyPartR15.LowerTorso,
                    LeftUpperArm = Enum.BodyPartR15.LeftUpperArm,
                    LeftLowerArm = Enum.BodyPartR15.LeftLowerArm,
                    LeftHand = Enum.BodyPartR15.LeftHand,
                    RightUpperArm = Enum.BodyPartR15.RightUpperArm,
                    RightLowerArm = Enum.BodyPartR15.RightLowerArm,
                    RightHand = Enum.BodyPartR15.RightHand,
                    LeftUpperLeg = Enum.BodyPartR15.LeftUpperLeg,
                    LeftLowerLeg = Enum.BodyPartR15.LeftLowerLeg,
                    LeftFoot = Enum.BodyPartR15.LeftFoot,
                    RightUpperLeg = Enum.BodyPartR15.RightUpperLeg,
                    RightLowerLeg = Enum.BodyPartR15.RightLowerLeg,
                    RightFoot = Enum.BodyPartR15.RightFoot,
                }
                return mapping[name] and humanoid:GetBodyPartR15(mapping[name]) or nil
            end)
            if success and bodyPart then
                local actualPart = character:FindFirstChild(bodyPart.Name) or bodyPart
                if actualPart and actualPart:IsA("BasePart") then return actualPart end
            end
        end
        return nil
    end

    local drawnCharacters = {}

    local function createLineFrame(parent, color, thickness)
        local frame = Instance.new("Frame")
        frame.AnchorPoint = Vector2.new(0.5, 0.5)
        frame.BackgroundColor3 = color
        frame.BorderSizePixel = 0
        frame.Size = UDim2.fromOffset(0, thickness)
        frame.Visible = false
        frame.ZIndex = 50
        frame.Parent = parent
        return frame
    end

    local function cleanCharacter(character)
        local data = drawnCharacters[character]
        if data then
            for _, bone in pairs(data.bones) do
                if bone then bone:Destroy() end
            end
            drawnCharacters[character] = nil
        end
    end

    local function cleanAll()
        for character, _ in pairs(drawnCharacters) do
            cleanCharacter(character)
        end
    end

    local function updateCharacterBones(character)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            cleanCharacter(character)
            return
        end

        local pairs = getBonePairs(character)
        local data = drawnCharacters[character]
        if not data then
            data = { bones = {}, pairs = pairs }
            drawnCharacters[character] = data
            for i = 1, #pairs do
                data.bones[i] = createLineFrame(BoneGui, getgenv().BoneESPColor, getgenv().BoneESPThickness)
            end
        end

        for i, pair in ipairs(pairs) do
            local bone = data.bones[i]
            if bone then
                local partA = getPart(character, pair[1])
                local partB = getPart(character, pair[2])
                if partA and partB then
                    local posA, onScreenA = Camera:WorldToViewportPoint(partA.Position)
                    local posB, onScreenB = Camera:WorldToViewportPoint(partB.Position)
                    if onScreenA and onScreenB then
                        local vA = Vector2.new(posA.X, posA.Y)
                        local vB = Vector2.new(posB.X, posB.Y)
                        local diff = vB - vA
                        local length = diff.Magnitude
                        local mid = (vA + vB) / 2
                        local angle = math.deg(math.atan2(diff.Y, diff.X))

                        bone.Size = UDim2.fromOffset(length, getgenv().BoneESPThickness)
                        bone.Position = UDim2.fromOffset(mid.X, mid.Y)
                        bone.Rotation = angle
                        bone.BackgroundColor3 = getgenv().BoneESPColor
                        bone.Visible = true
                    else
                        bone.Visible = false
                    end
                else
                    bone.Visible = false
                end
            end
        end
    end

    local UPDATE_INTERVAL = 1 / 30
    local lastUpdateTime = 0

    local renderConnection
    renderConnection = RunService.RenderStepped:Connect(function()
        local now = tick()
        if now - lastUpdateTime < UPDATE_INTERVAL then
            return
        end
        lastUpdateTime = now

        if not getgenv().BoneESPEnabled then
            for _, data in pairs(drawnCharacters) do
                for _, bone in pairs(data.bones) do
                    if bone then bone.Visible = false end
                end
            end
            return
        end

